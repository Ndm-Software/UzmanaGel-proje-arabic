rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
  
    // Profile Photos: Anyone can read, only the owner can write
    match /profile_photos/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Portfolio Images/Files: Anyone can read, only the owner can write
    match /portfolio/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Before/After Gallery: Anyone can read, only the owner can write
    match /beforeAfter/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Address Change Verification Documents: Only the owner can read/write
    match /address_requests/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Fallback rule: Allow read/write for authenticated users for any other files
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
